# Copy to .env.local — overrides dev default (http://adan.test/api)
# Production values live in .env.production (committed — public Firebase keys only).

# VITE_API_URL=https://lightgray-marten-830794.hostingersite.com/api

# Firebase Web (public). Copy from adan/.env: FIREBASE_WEB_* → VITE_FIREBASE_* (same values).
# VAPID: Firebase Console → Project settings → Cloud Messaging → Web push certificates
# Run: npm run firebase:env
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_FIREBASE_VAPID_KEY=

# Server-side only — place firebase-service-account.json in repo root (gitignored)
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Live deploy checklist:
# 1. npm run build — must produce dist/firebase-messaging-sw.js
# 2. Firebase Console → Authentication → Settings → Authorized domains → add your live site hostname
# 3. Hostinger: upload all of dist/ including firebase-messaging-sw.js and .htaccess
# 4. Vercel: set the same VITE_* vars if you override .env.production
